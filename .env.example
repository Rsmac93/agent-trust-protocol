# ---- Agent Trust Protocol :: deployment env ----
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Deployer private key (0x-prefixed). Fund this address with Base Sepolia ETH.
PRIVATE_KEY=0x...

# RPC + verification
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=your_basescan_api_key

# Protocol role addresses. All OPTIONAL on testnet — any left unset default
# to the deployer address. Set real multisigs for anything beyond a solo run.
TREASURY=
LIQUIDITY=
TEAM_BENEFICIARY=
BUILDER_POOL=
FEE_TREASURY=
ARBITER=
INSURANCE_FUND=

# Filled in AFTER deployment, for the smoke test:
REGISTRY=
